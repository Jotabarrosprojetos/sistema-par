# Dependencies
node_modules/
backend/node_modules/
frontend/node_modules/

# Environment variables (contains secrets)
backend/.env
.env

# Google credentials (NEVER commit these)
backend/credentials/*.json
backend/credentials/*.p12

# Frontend build output
frontend/dist/
frontend/dist-ssr/

# Vite cache
frontend/.vite/

# Logs
*.log
npm-debug.log*
backend/logs/

# OS files
.DS_Store
Thumbs.db

# Editor
.vscode/settings.json
*.swp
backend/levantamento-resultado-completo.json
*-resultado-completo.json

