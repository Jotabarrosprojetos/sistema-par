*.env
.env.*
**/.env.*
!.env.example
!frontend/.env.production

# Dados exportados do OPP / planilhas de trabalho — nunca no repositorio (OS 3, condicao b)
*.xlsx
*.xls
*.csv
backend/ref-*.json
